                20 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut SpanRef, len),
                    ));
                }
                21 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut WhenThenRef, len),
                    ));
                }
                22 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut ExprRef, len),
                    ));
                }
                _ => unreachable!("section_count is fixed by this build"),
            }
        }
    }
}

// ------------------------------------------------------------------
// The @stable typed projections
// ------------------------------------------------------------------

/// A @stable `data_type` node: the typed projection over the
/// frozen layout.
#[derive(Clone, Copy)]
pub struct StableDataType<'t> {
    node: Node<'t>,
}

impl<'t> StableDataType<'t> {
    /// The generic cursor, for ports and introspection.
    pub fn node(self) -> Node<'t> {
        self.node
    }

    /// The constructor tag.
    pub fn tag(self) -> Option<DataTypeTag> {
        let tree = self.node.tree();
        let ty = tree.type_by_name("data_type")?;
        DataTypeTag::from_u16(tree.sum_tag(ty, self.node.index())?)
    }

    /// The payload as `Int`, when that is the constructor.
    pub fn as_int(self) -> Option<&'t data_type::Int> {
        let tree = self.node.tree();
        let ty = tree.type_by_name("data_type")?;
        let (ptr, stride) =
            tree.payload_ptr(ty, self.node.index(), DataTypeTag::Int as u16)?;
        if stride != std::mem::size_of::<data_type::Int>() {
            return None;
        }
        Some(unsafe { &*(ptr as *const data_type::Int) })
    }

    /// The payload as `Bool`, when that is the constructor.
    pub fn as_bool(self) -> Option<&'t data_type::Bool> {
        let tree = self.node.tree();
        let ty = tree.type_by_name("data_type")?;
        let (ptr, stride) =
            tree.payload_ptr(ty, self.node.index(), DataTypeTag::Bool as u16)?;
        if stride != std::mem::size_of::<data_type::Bool>() {
            return None;
        }
        Some(unsafe { &*(ptr as *const data_type::Bool) })
    }
}

/// Typed `@stable` projections on [`Node`].
pub trait StableNodeExt<'t> {
    /// This node as a @stable `data_type`, when it IS one.
    /// The record shape is guaranteed by the load-time
    /// `abi_version` handshake.
    fn as_data_type(self) -> Option<StableDataType<'t>>;

    /// This node as the @stable `when_then` record, when it IS
    /// a `when_then`. The record shape is guaranteed by the
    /// load-time `abi_version` handshake; the stride check below
    /// is the per-call assertion of that contract.
    fn as_when_then(self) -> Option<&'t WhenThen>;
}

impl<'t> StableNodeExt<'t> for Node<'t> {
    fn as_data_type(self) -> Option<StableDataType<'t>> {
        let tree = self.tree();
        if tree.type_by_name("data_type") != Some(self.type_index()) {
            return None;
        }
        Some(StableDataType { node: self })
    }

    fn as_when_then(self) -> Option<&'t WhenThen> {
        let tree = self.tree();
        let ty = tree.type_by_name("when_then")?;
        if ty != self.type_index() {
            return None;
        }
        let (ptr, stride) = tree.product_ptr(ty, self.index())?;
        if stride != std::mem::size_of::<WhenThen>() {
            return None;
        }
        Some(unsafe { &*(ptr as *const WhenThen) })
    }
}

// ------------------------------------------------------------------
// The @stable freeze dump
// ------------------------------------------------------------------

/// A canonical text dump of the `@stable` region's layout: record
/// sizes/alignments, field offsets and types, and variant
/// discriminants. `tests/freeze.rs` byte-compares it against the
/// checked-in snapshot `sql-abi/stable_layout.txt`; regenerating a
/// changed layout requires an `ABI_VERSION` bump.
pub fn freeze_stable_layout() -> String {
    let mut out = String::new();
    use std::fmt::Write as _;
    writeln!(out, "abi_version: {}", ABI_VERSION).unwrap();
    writeln!(out).unwrap();
    writeln!(out, "type data_type: sum").unwrap();
    writeln!(out, "    variant 0: Int size {} align {}",
        std::mem::size_of::<data_type::Int>(), std::mem::align_of::<data_type::Int>()).unwrap();
    writeln!(out, "        span: SpanRef @{}", std::mem::offset_of!(data_type::Int, span)).unwrap();
    writeln!(out, "        nullable: u8 @{}", std::mem::offset_of!(data_type::Int, nullable)).unwrap();
    writeln!(out, "        unsigned: OptBool @{}", std::mem::offset_of!(data_type::Int, unsigned)).unwrap();
    writeln!(out, "        width: OptByte @{}", std::mem::offset_of!(data_type::Int, width)).unwrap();
    writeln!(out, "    variant 1: Bool size {} align {}",
        std::mem::size_of::<data_type::Bool>(), std::mem::align_of::<data_type::Bool>()).unwrap();
    writeln!(out, "        span: SpanRef @{}", std::mem::offset_of!(data_type::Bool, span)).unwrap();
    writeln!(out, "        nullable: u8 @{}", std::mem::offset_of!(data_type::Bool, nullable)).unwrap();
    writeln!(out).unwrap();
    writeln!(out, "type when_then: product size {} align {}",
        std::mem::size_of::<WhenThen>(), std::mem::align_of::<WhenThen>()).unwrap();
    writeln!(out, "    when: ExprRef @{}", std::mem::offset_of!(WhenThen, when)).unwrap();
    writeln!(out, "    then: ExprRef @{}", std::mem::offset_of!(WhenThen, then)).unwrap();
    writeln!(out, "    op: bin_op(u8)? @{}", std::mem::offset_of!(WhenThen, op)).unwrap();
    writeln!(out).unwrap();
    writeln!(out, "type bin_op: simple_sum (referenced by a stable field)").unwrap();
    writeln!(out, "    variant 0: Add").unwrap();
    writeln!(out, "    variant 1: Sub").unwrap();
    writeln!(out, "    variant 2: Eq").unwrap();
    out
}

