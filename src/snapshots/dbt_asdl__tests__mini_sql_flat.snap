/// The schema of the sql.asdl this build was generated from.
#[cfg(feature = "builder")]
pub static SCHEMA: FlatSchema = FlatSchema {
    abi_version: ABI_VERSION,
    schema_hash: SCHEMA_HASH,
    types: TYPES.as_ptr(),
    type_count: TYPES.len() as u32,
    ctors: CTORS.as_ptr(),
    ctor_count: CTORS.len() as u32,
    root_type: 13,
};

/// The type indices of this build's schema: host code resolves types
/// by name through the descriptor; these constants serve the library's
/// own builder and tests.
#[cfg(feature = "builder")]
pub mod ty {
    pub const IDENTIFIER: u16 = 0;
    pub const STRING: u16 = 1;
    pub const BYTE: u16 = 2;
    pub const INT: u16 = 3;
    pub const LONG: u16 = 4;
    pub const BOOL: u16 = 5;
    pub const CODE_LOCATION: u16 = 6;
    pub const SPAN: u16 = 7;
    pub const BIN_OP: u16 = 8;
    pub const DATA_TYPE: u16 = 9;
    pub const LITERAL: u16 = 10;
    pub const WHEN_THEN: u16 = 11;
    pub const EXPR: u16 = 12;
    pub const FILE: u16 = 13;
}
