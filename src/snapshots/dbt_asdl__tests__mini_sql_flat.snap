/// The schema of the sql.asdl this build was generated from.
#[cfg(feature = "builder")]
pub static SCHEMA: FlatSchema = FlatSchema {
    runtime_abi_version: RUNTIME_ABI_VERSION,
    abi_version: ABI_VERSION,
    schema_hash: SCHEMA_HASH,
    strings_len: SCHEMA_STRINGS.len() as u32,
    type_count: TYPES.len() as u16,
    ctor_count: CTORS.len() as u16,
    field_count: FIELDS.len() as u16,
    root_type: 13,
    strings: SCHEMA_STRINGS.as_ptr(),
    types: TYPES.as_ptr(),
    ctors: CTORS.as_ptr(),
    fields: FIELDS.as_ptr(),
};

