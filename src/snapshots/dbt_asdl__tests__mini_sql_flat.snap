// The constructor tag of every compound sum: the index within the
// sum, in sql.asdl declaration order. Append new constructors at the
// end; a reorder is a schema break.

/// The constructor tag of a `data_type` node.
#[repr(u16)]
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum DataTypeTag {
    Int = 0,
    Bool = 1,
}

impl DataTypeTag {
    /// The tag's constructor, or None for a value this schema
    /// does not know (a skewed library's later addition).
    pub fn from_u16(v: u16) -> Option<Self> {
        Some(match v {
            0 => DataTypeTag::Int,
            1 => DataTypeTag::Bool,
            _ => return None,
        })
    }
}

/// The constructor tag of a `literal` node.
#[repr(u16)]
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum LiteralTag {
    Number = 0,
    String = 1,
    Null = 2,
}

impl LiteralTag {
    /// The tag's constructor, or None for a value this schema
    /// does not know (a skewed library's later addition).
    pub fn from_u16(v: u16) -> Option<Self> {
        Some(match v {
            0 => LiteralTag::Number,
            1 => LiteralTag::String,
            2 => LiteralTag::Null,
            _ => return None,
        })
    }
}

/// The constructor tag of a `expr` node.
#[repr(u16)]
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum ExprTag {
    Identifier = 0,
    Literal = 1,
    BinaryOp = 2,
    Case = 3,
    Cast = 4,
}

impl ExprTag {
    /// The tag's constructor, or None for a value this schema
    /// does not know (a skewed library's later addition).
    pub fn from_u16(v: u16) -> Option<Self> {
        Some(match v {
            0 => ExprTag::Identifier,
            1 => ExprTag::Literal,
            2 => ExprTag::BinaryOp,
            3 => ExprTag::Case,
            4 => ExprTag::Cast,
            _ => return None,
        })
    }
}

// The record types: one #[repr(C)] struct per product and per
// payload-carrying constructor. Field order is attributes first,
// then declaration order; the C ABI fixes the layout. These same
// structs are the @stable types' typed projections: stability is a
// contract over this layout, not a second encoding.

/// The `code_location` record.
#[repr(C)]
#[derive(Clone, Copy, Debug)]
pub struct CodeLocation {
    pub lineno: OptInt,
    pub col_offset: OptInt,
    pub index: OptLong,
}

/// The `span` record.
#[repr(C)]
#[derive(Clone, Copy, Debug)]
pub struct Span {
    pub start: CodeLocationRef,
    pub end: CodeLocationRef,
}

/// The `data_type` payload records: one struct per
/// constructor, attributes first.
///
/// @stable: shape guaranteed by the `abi_version` load
/// handshake.
pub mod data_type {
    use super::*;

    /// `DataType::Int`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct Int {
        pub span: SpanRef,
        pub nullable: u8,
        pub unsigned: OptBool,
        pub width: OptByte,
    }

    /// `DataType::Bool`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct Bool {
        pub span: SpanRef,
        pub nullable: u8,
    }
}

/// The `literal` payload records: one struct per
/// constructor, attributes first.
pub mod literal {
    use super::*;

    /// `Literal::Number`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct Number {
        pub span: SpanRef,
        pub text: FlatStr,
    }

    /// `Literal::String`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct String {
        pub span: SpanRef,
        pub value: FlatStr,
    }

    /// `Literal::Null`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct Null {
        pub span: SpanRef,
    }
}

/// The `when_then` record (@stable: shape guaranteed by
/// the `abi_version` load handshake).
#[repr(C)]
#[derive(Clone, Copy, Debug)]
pub struct WhenThen {
    pub when: ExprRef,
    pub then: ExprRef,
    pub op: u8,
}

/// The `expr` payload records: one struct per
/// constructor, attributes first.
pub mod expr {
    use super::*;

    /// `Expr::Identifier`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct Identifier {
        pub span: SpanRef,
        pub parts: FlatSeq,
    }

    /// `Expr::Literal`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct Literal {
        pub span: SpanRef,
        pub value: LiteralRef,
    }

    /// `Expr::BinaryOp`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct BinaryOp {
        pub span: SpanRef,
        pub left: ExprRef,
        pub op: u8,
        pub right: ExprRef,
    }

    /// `Expr::Case`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct Case {
        pub span: SpanRef,
        pub operand: ExprRef,
        pub cases: FlatSeq,
        pub r#else: ExprRef,
    }

    /// `Expr::Cast`.
    #[repr(C)]
    #[derive(Clone, Copy, Debug)]
    pub struct Cast {
        pub span: SpanRef,
        pub e: ExprRef,
        pub to: DataTypeRef,
        pub notes: FlatSeq,
    }
}

/// The `file` record.
#[repr(C)]
#[derive(Clone, Copy, Debug)]
pub struct File {
    pub exprs: FlatSeq,
    pub spans: FlatSeq,
}

// ------------------------------------------------------------------
// The library-side builder: the freeze buffer the converter writes
// into. Hosts never build trees, so all of it is behind `convert`.
// ------------------------------------------------------------------

#[cfg(feature = "builder")]
/// The flat tree under construction: one growable buffer per section.
/// Indices need no fixups on growth, so nodes can be pushed in any
/// order (children first is the natural order for lowerings). `finish`
/// freezes the buffers into a `FlatTree` for the host.
pub struct TreeBuilder {
    strings: Vec<u8>,
    code_location_nodes: Vec<CodeLocation>,
    span_nodes: Vec<Span>,
    data_type_nodes: Vec<FlatNode>,
    data_type_int: Vec<data_type::Int>,
    data_type_bool: Vec<data_type::Bool>,
    literal_nodes: Vec<FlatNode>,
    literal_number: Vec<literal::Number>,
    literal_string: Vec<literal::String>,
    literal_null: Vec<literal::Null>,
    when_then_nodes: Vec<WhenThen>,
    expr_nodes: Vec<FlatNode>,
    expr_identifier: Vec<expr::Identifier>,
    expr_literal: Vec<expr::Literal>,
    expr_binary_op: Vec<expr::BinaryOp>,
    expr_case: Vec<expr::Case>,
    expr_cast: Vec<expr::Cast>,
    file_nodes: Vec<File>,
    identifier_seq: Vec<FlatStr>,
    string_seq: Vec<FlatStr>,
    span_seq: Vec<SpanRef>,
    when_then_seq: Vec<WhenThenRef>,
    expr_seq: Vec<ExprRef>,
}

#[cfg(feature = "builder")]
impl TreeBuilder {
    /// An empty tree under construction.
    pub fn new() -> Self {
        TreeBuilder {
            strings: Vec::new(),
            code_location_nodes: Vec::new(),
            span_nodes: Vec::new(),
            data_type_nodes: Vec::new(),
            data_type_int: Vec::new(),
            data_type_bool: Vec::new(),
            literal_nodes: Vec::new(),
            literal_number: Vec::new(),
            literal_string: Vec::new(),
            literal_null: Vec::new(),
            when_then_nodes: Vec::new(),
            expr_nodes: Vec::new(),
            expr_identifier: Vec::new(),
            expr_literal: Vec::new(),
            expr_binary_op: Vec::new(),
            expr_case: Vec::new(),
            expr_cast: Vec::new(),
            file_nodes: Vec::new(),
            identifier_seq: Vec::new(),
            string_seq: Vec::new(),
            span_seq: Vec::new(),
            when_then_seq: Vec::new(),
            expr_seq: Vec::new(),
        }
    }

    /// A string into the tree's UTF-8 blob.
    pub fn push_str(&mut self, s: &str) -> FlatStr {
        let off = self.strings.len() as u32;
        self.strings.extend_from_slice(s.as_bytes());
        FlatStr { off, len: s.len() as u32 }
    }

    /// Push a `code_location` node.
    pub fn push_code_location(&mut self, r: CodeLocation) -> CodeLocationRef {
        let i = self.code_location_nodes.len() as u32;
        self.code_location_nodes.push(r);
        CodeLocationRef(i)
    }

    /// Push a `span` node.
    pub fn push_span(&mut self, r: Span) -> SpanRef {
        let i = self.span_nodes.len() as u32;
        self.span_nodes.push(r);
        SpanRef(i)
    }

    /// Push a `Int` node of `data_type`.
    pub fn push_data_type_int(&mut self, r: data_type::Int) -> DataTypeRef {
        let payload = self.data_type_int.len() as u32;
        self.data_type_int.push(r);
        let i = self.data_type_nodes.len() as u32;
        self.data_type_nodes.push(FlatNode {
            tag: DataTypeTag::Int as u16,
            _pad: 0,
            payload,
        });
        DataTypeRef(i)
    }

    /// Push a `Bool` node of `data_type`.
    pub fn push_data_type_bool(&mut self, r: data_type::Bool) -> DataTypeRef {
        let payload = self.data_type_bool.len() as u32;
        self.data_type_bool.push(r);
        let i = self.data_type_nodes.len() as u32;
        self.data_type_nodes.push(FlatNode {
            tag: DataTypeTag::Bool as u16,
            _pad: 0,
            payload,
        });
        DataTypeRef(i)
    }

    /// Push a `Number` node of `literal`.
    pub fn push_literal_number(&mut self, r: literal::Number) -> LiteralRef {
        let payload = self.literal_number.len() as u32;
        self.literal_number.push(r);
        let i = self.literal_nodes.len() as u32;
        self.literal_nodes.push(FlatNode {
            tag: LiteralTag::Number as u16,
            _pad: 0,
            payload,
        });
        LiteralRef(i)
    }

    /// Push a `String` node of `literal`.
    pub fn push_literal_string(&mut self, r: literal::String) -> LiteralRef {
        let payload = self.literal_string.len() as u32;
        self.literal_string.push(r);
        let i = self.literal_nodes.len() as u32;
        self.literal_nodes.push(FlatNode {
            tag: LiteralTag::String as u16,
            _pad: 0,
            payload,
        });
        LiteralRef(i)
    }

    /// Push a `Null` node of `literal`.
    pub fn push_literal_null(&mut self, r: literal::Null) -> LiteralRef {
        let payload = self.literal_null.len() as u32;
        self.literal_null.push(r);
        let i = self.literal_nodes.len() as u32;
        self.literal_nodes.push(FlatNode {
            tag: LiteralTag::Null as u16,
            _pad: 0,
            payload,
        });
        LiteralRef(i)
    }

    /// Push a `when_then` node.
    pub fn push_when_then(&mut self, r: WhenThen) -> WhenThenRef {
        let i = self.when_then_nodes.len() as u32;
        self.when_then_nodes.push(r);
        WhenThenRef(i)
    }

    /// Push a `Identifier` node of `expr`.
    pub fn push_expr_identifier(&mut self, r: expr::Identifier) -> ExprRef {
        let payload = self.expr_identifier.len() as u32;
        self.expr_identifier.push(r);
        let i = self.expr_nodes.len() as u32;
        self.expr_nodes.push(FlatNode {
            tag: ExprTag::Identifier as u16,
            _pad: 0,
            payload,
        });
        ExprRef(i)
    }

    /// Push a `Literal` node of `expr`.
    pub fn push_expr_literal(&mut self, r: expr::Literal) -> ExprRef {
        let payload = self.expr_literal.len() as u32;
        self.expr_literal.push(r);
        let i = self.expr_nodes.len() as u32;
        self.expr_nodes.push(FlatNode {
            tag: ExprTag::Literal as u16,
            _pad: 0,
            payload,
        });
        ExprRef(i)
    }

    /// Push a `BinaryOp` node of `expr`.
    pub fn push_expr_binary_op(&mut self, r: expr::BinaryOp) -> ExprRef {
        let payload = self.expr_binary_op.len() as u32;
        self.expr_binary_op.push(r);
        let i = self.expr_nodes.len() as u32;
        self.expr_nodes.push(FlatNode {
            tag: ExprTag::BinaryOp as u16,
            _pad: 0,
            payload,
        });
        ExprRef(i)
    }

    /// Push a `Case` node of `expr`.
    pub fn push_expr_case(&mut self, r: expr::Case) -> ExprRef {
        let payload = self.expr_case.len() as u32;
        self.expr_case.push(r);
        let i = self.expr_nodes.len() as u32;
        self.expr_nodes.push(FlatNode {
            tag: ExprTag::Case as u16,
            _pad: 0,
            payload,
        });
        ExprRef(i)
    }

    /// Push a `Cast` node of `expr`.
    pub fn push_expr_cast(&mut self, r: expr::Cast) -> ExprRef {
        let payload = self.expr_cast.len() as u32;
        self.expr_cast.push(r);
        let i = self.expr_nodes.len() as u32;
        self.expr_nodes.push(FlatNode {
            tag: ExprTag::Cast as u16,
            _pad: 0,
            payload,
        });
        ExprRef(i)
    }

    /// Push a `file` node.
    pub fn push_file(&mut self, r: File) -> FileRef {
        let i = self.file_nodes.len() as u32;
        self.file_nodes.push(r);
        FileRef(i)
    }

    /// A sequence of `identifier` into the pool.
    pub fn push_identifier_seq(&mut self, items: &[FlatStr]) -> FlatSeq {
        let off = self.identifier_seq.len() as u32;
        self.identifier_seq.extend_from_slice(items);
        FlatSeq { off, len: items.len() as u32 }
    }

    /// A sequence of `string` into the pool.
    pub fn push_string_seq(&mut self, items: &[FlatStr]) -> FlatSeq {
        let off = self.string_seq.len() as u32;
        self.string_seq.extend_from_slice(items);
        FlatSeq { off, len: items.len() as u32 }
    }

    /// A sequence of `span` into the pool.
    pub fn push_span_seq(&mut self, items: &[SpanRef]) -> FlatSeq {
        let off = self.span_seq.len() as u32;
        self.span_seq.extend_from_slice(items);
        FlatSeq { off, len: items.len() as u32 }
    }

    /// A sequence of `when_then` into the pool.
    pub fn push_when_then_seq(&mut self, items: &[WhenThenRef]) -> FlatSeq {
        let off = self.when_then_seq.len() as u32;
        self.when_then_seq.extend_from_slice(items);
        FlatSeq { off, len: items.len() as u32 }
    }

    /// A sequence of `expr` into the pool.
    pub fn push_expr_seq(&mut self, items: &[ExprRef]) -> FlatSeq {
        let off = self.expr_seq.len() as u32;
        self.expr_seq.extend_from_slice(items);
        FlatSeq { off, len: items.len() as u32 }
    }

    /// Freeze the buffers into a host-ready `FlatTree`. The buffers are
    /// boxed in place and the header points at them; `release` (called
    /// by the host, or by `Tree`'s Drop) frees everything.
    pub fn finish(self, root: FileRef) -> *mut FlatTree {
        let mut sections: Vec<FlatSection> = Vec::new();
        macro_rules! sec {
            ($v:expr, $elem:ty) => {{
                let b = $v.into_boxed_slice();
                let len = b.len() as u32;
                let ptr = Box::into_raw(b) as *mut u8;
                sections.push(FlatSection {
                    ptr,
                    len,
                    stride: std::mem::size_of::<$elem>() as u32,
                });
            }};
        }
        sec!(self.strings, u8);
        sec!(self.code_location_nodes, CodeLocation);
        sec!(self.span_nodes, Span);
        sec!(self.data_type_nodes, FlatNode);
        sec!(self.data_type_int, data_type::Int);
        sec!(self.data_type_bool, data_type::Bool);
        sec!(self.literal_nodes, FlatNode);
        sec!(self.literal_number, literal::Number);
        sec!(self.literal_string, literal::String);
        sec!(self.literal_null, literal::Null);
        sec!(self.when_then_nodes, WhenThen);
        sec!(self.expr_nodes, FlatNode);
        sec!(self.expr_identifier, expr::Identifier);
        sec!(self.expr_literal, expr::Literal);
        sec!(self.expr_binary_op, expr::BinaryOp);
        sec!(self.expr_case, expr::Case);
        sec!(self.expr_cast, expr::Cast);
        sec!(self.file_nodes, File);
        sec!(self.identifier_seq, FlatStr);
        sec!(self.string_seq, FlatStr);
        sec!(self.span_seq, SpanRef);
        sec!(self.when_then_seq, WhenThenRef);
        sec!(self.expr_seq, ExprRef);
        let sections = Box::into_raw(sections.into_boxed_slice());
        let tree = Box::new(FlatTree {
            abi_version: ABI_VERSION,
            schema_hash: SCHEMA_HASH,
            release,
            schema: &SCHEMA,
            sections: sections as *mut FlatSection,
            section_count: 23,
            root_index: root.0,
        });
        Box::into_raw(tree)
    }
}

#[cfg(feature = "builder")]
impl Default for TreeBuilder {
    fn default() -> Self {
        Self::new()
    }
}

/// The tree destructor named by the header: frees the sections (each a
/// boxed slice of plain data) and the header itself.
#[cfg(feature = "builder")]
unsafe extern "C" fn release(tree: *mut FlatTree) {
    unsafe {
        let tree = Box::from_raw(tree);
        let sections = Box::from_raw(std::ptr::slice_from_raw_parts_mut(
            tree.sections,
            tree.section_count as usize,
        ));
        for (i, s) in sections.iter().enumerate() {
            let ptr = s.ptr;
            let len = s.len as usize;
            match i {
                0 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut u8, len),
                    ));
                }
                1 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut CodeLocation, len),
                    ));
                }
                2 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut Span, len),
                    ));
                }
                3 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut FlatNode, len),
                    ));
                }
                4 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut data_type::Int, len),
                    ));
                }
                5 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut data_type::Bool, len),
                    ));
                }
                6 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut FlatNode, len),
                    ));
                }
                7 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut literal::Number, len),
                    ));
                }
                8 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut literal::String, len),
                    ));
                }
                9 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut literal::Null, len),
                    ));
                }
                10 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut WhenThen, len),
                    ));
                }
                11 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut FlatNode, len),
                    ));
                }
                12 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut expr::Identifier, len),
                    ));
                }
                13 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut expr::Literal, len),
                    ));
                }
                14 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut expr::BinaryOp, len),
                    ));
                }
                15 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut expr::Case, len),
                    ));
                }
                16 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut expr::Cast, len),
                    ));
                }
                17 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut File, len),
                    ));
                }
                18 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut FlatStr, len),
                    ));
                }
                19 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut FlatStr, len),
                    ));
                }
                20 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut SpanRef, len),
                    ));
                }
                21 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut WhenThenRef, len),
                    ));
                }
                22 => {
                    drop(Box::from_raw(
                        std::ptr::slice_from_raw_parts_mut(ptr as *mut ExprRef, len),
                    ));
                }
                _ => unreachable!("section_count is fixed by this build"),
            }
        }
    }
}

// ------------------------------------------------------------------
// The @stable typed projections
// ------------------------------------------------------------------

/// A @stable `data_type` node: the typed projection over the
/// frozen layout.
#[derive(Clone, Copy)]
pub struct StableDataType<'t> {
    node: Node<'t>,
}

impl<'t> Node<'t> {
    /// This node as a @stable `data_type`, when it IS one.
    /// The record shape is guaranteed by the load-time
    /// `abi_version` handshake.
    pub fn as_data_type(self) -> Option<StableDataType<'t>> {
        let tree = self.tree();
        if tree.type_by_name("data_type") != Some(self.type_index()) {
            return None;
        }
        Some(StableDataType { node: self })
    }
}

impl<'t> StableDataType<'t> {
    /// The generic cursor, for ports and introspection.
    pub fn node(self) -> Node<'t> {
        self.node
    }

    /// The constructor tag.
    pub fn tag(self) -> Option<DataTypeTag> {
        let tree = self.node.tree();
        let ty = tree.type_by_name("data_type")?;
        DataTypeTag::from_u16(tree.sum_tag(ty, self.node.index())?)
    }

    /// The payload as `Int`, when that is the constructor.
    pub fn as_int(self) -> Option<&'t data_type::Int> {
        let tree = self.node.tree();
        let ty = tree.type_by_name("data_type")?;
        let (ptr, stride) =
            tree.payload_ptr(ty, self.node.index(), DataTypeTag::Int as u16)?;
        if stride != std::mem::size_of::<data_type::Int>() {
            return None;
        }
        Some(unsafe { &*(ptr as *const data_type::Int) })
    }

    /// The payload as `Bool`, when that is the constructor.
    pub fn as_bool(self) -> Option<&'t data_type::Bool> {
        let tree = self.node.tree();
        let ty = tree.type_by_name("data_type")?;
        let (ptr, stride) =
            tree.payload_ptr(ty, self.node.index(), DataTypeTag::Bool as u16)?;
        if stride != std::mem::size_of::<data_type::Bool>() {
            return None;
        }
        Some(unsafe { &*(ptr as *const data_type::Bool) })
    }
}

impl<'t> Node<'t> {
    /// This node as the @stable `when_then` record, when it IS
    /// a `when_then`. The record shape is guaranteed by the
    /// load-time `abi_version` handshake; the stride check below
    /// is the per-call assertion of that contract.
    pub fn as_when_then(self) -> Option<&'t WhenThen> {
        let tree = self.tree();
        let ty = tree.type_by_name("when_then")?;
        if ty != self.type_index() {
            return None;
        }
        let (ptr, stride) = tree.product_ptr(ty, self.index())?;
        if stride != std::mem::size_of::<WhenThen>() {
            return None;
        }
        Some(unsafe { &*(ptr as *const WhenThen) })
    }
}

// ------------------------------------------------------------------
// The @stable freeze dump
// ------------------------------------------------------------------

/// A canonical text dump of the `@stable` region's layout: record
/// sizes/alignments, field offsets and types, and variant
/// discriminants. `tests/freeze.rs` byte-compares it against the
/// checked-in snapshot `sql-abi/stable_layout.txt`; regenerating a
/// changed layout requires an `ABI_VERSION` bump.
pub fn freeze_stable_layout() -> String {
    let mut out = String::new();
    use std::fmt::Write as _;
    writeln!(out, "abi_version: {}", ABI_VERSION).unwrap();
    writeln!(out).unwrap();
    writeln!(out, "type data_type: sum").unwrap();
    writeln!(out, "    variant 0: Int size {} align {}",
        std::mem::size_of::<data_type::Int>(), std::mem::align_of::<data_type::Int>()).unwrap();
    writeln!(out, "        span: SpanRef @{}", std::mem::offset_of!(data_type::Int, span)).unwrap();
    writeln!(out, "        nullable: u8 @{}", std::mem::offset_of!(data_type::Int, nullable)).unwrap();
    writeln!(out, "        unsigned: OptBool @{}", std::mem::offset_of!(data_type::Int, unsigned)).unwrap();
    writeln!(out, "        width: OptByte @{}", std::mem::offset_of!(data_type::Int, width)).unwrap();
    writeln!(out, "    variant 1: Bool size {} align {}",
        std::mem::size_of::<data_type::Bool>(), std::mem::align_of::<data_type::Bool>()).unwrap();
    writeln!(out, "        span: SpanRef @{}", std::mem::offset_of!(data_type::Bool, span)).unwrap();
    writeln!(out, "        nullable: u8 @{}", std::mem::offset_of!(data_type::Bool, nullable)).unwrap();
    writeln!(out).unwrap();
    writeln!(out, "type when_then: product size {} align {}",
        std::mem::size_of::<WhenThen>(), std::mem::align_of::<WhenThen>()).unwrap();
    writeln!(out, "    when: ExprRef @{}", std::mem::offset_of!(WhenThen, when)).unwrap();
    writeln!(out, "    then: ExprRef @{}", std::mem::offset_of!(WhenThen, then)).unwrap();
    writeln!(out, "    op: bin_op(u8)? @{}", std::mem::offset_of!(WhenThen, op)).unwrap();
    writeln!(out).unwrap();
    writeln!(out, "type bin_op: simple_sum (referenced by a stable field)").unwrap();
    writeln!(out, "    variant 0: Add").unwrap();
    writeln!(out, "    variant 1: Sub").unwrap();
    writeln!(out, "    variant 2: Eq").unwrap();
    out
}

